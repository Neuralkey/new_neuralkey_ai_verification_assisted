# ==============================================================================
# Neuralkey Verification Assistant - Environment Variables
# Copy this file to .env and fill in the required values.
# ==============================================================================

# GEMINI_API_KEY: Required for server-side Gemini multimodal document & risk analysis.
# Automatically injected at runtime in Google AI Studio, or provide your own key for local development.
GEMINI_API_KEY=your_gemini_api_key_here

# PORT: Server port for the Express + Vite application (defaults to 3000)
PORT=3000

# NODE_ENV: Application environment ('development' or 'production')
NODE_ENV=development

# APP_URL: Public URL where the application is hosted
APP_URL=http://localhost:3000
